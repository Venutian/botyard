{
  "name": "botyard",
  "version": "2.9.1",
  "private": true,
  "type": "module",
  "description": "A studio run by a crew of AI bots, on your own computer: a 3D map of your projects, the bots that work in them, the engine that hands out their jobs, and a door for the phone app.",
  "homepage": "https://github.com/Venutian/botyard#readme",
  "license": "MIT",
  "author": "Botyard contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venutian/botyard.git",
    "directory": "studio"
  },
  "bugs": {
    "url": "https://github.com/Venutian/botyard/issues"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini",
    "opencode",
    "free-models",
    "agent-workspace",
    "agent-dashboard",
    "three.js",
    "3d",
    "developer-tools",
    "local-first"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "start": "node server/studio.mjs",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "install-service": "node tools/install.mjs",
    "check-clone": "node tools/fresh-clone-check.mjs",
    "demo": "node server/studio.mjs --demo",
    "shots": "node tools/shots.mjs",
    "phone": "node server/phone.mjs"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "qrcode-generator": "^2.0.4",
    "vite": "^7.1.0"
  }
}
